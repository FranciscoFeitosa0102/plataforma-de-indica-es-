import React from "react";
import { Card, CardHeader, CardTitle } from "@/components/ui/card";
import { Badge } from "@/components/ui/badge";
import LeadCard from "./LeadCard";

export default function KanbanColumn({ column, leads, isVendedor, currentUser }) {
  return (
    <Card className={`${column.color} border-2 shadow-lg flex flex-col`}>
      <CardHeader className="pb-3">
        <CardTitle className="text-sm font-semibold flex items-center justify-between">
          <span>{column.title}</span>
          <Badge variant="secondary" className="ml-2">
            {leads.length}
          </Badge>
        </CardTitle>
      </CardHeader>
      <div className="px-4 pb-4 space-y-3 min-h-[480px] overflow-y-auto flex-1">
        {leads.map((lead, index) => (
          <LeadCard
            key={lead.id}
            lead={lead}
            index={index}
            isVendedor={isVendedor}
            currentUser={currentUser}
          />
        ))}
        {leads.length === 0 && (
          <div className="text-center py-8 text-slate-400 text-sm">
            Nenhuma indicação
          </div>
        )}
      </div>
    </Card>
  );
}
